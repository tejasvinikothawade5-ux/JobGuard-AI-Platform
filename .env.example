# Copy this file to ".env" (same folder as app.py). Never commit .env.

# A long random string. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# (If you leave this out, a random key is created once and saved in .secret_key.)
JOBGUARD_SECRET_KEY=

# Password-reset emails. Leave blank to print reset links in the terminal (demo mode).
# Gmail: turn on 2-Step Verification, then create an "App password" and use it below.
JOBGUARD_SMTP_HOST=smtp.gmail.com
JOBGUARD_SMTP_PORT=587
JOBGUARD_SMTP_USER=
JOBGUARD_SMTP_PASSWORD=

# Public address used inside the reset email link (required for real email)
JOBGUARD_BASE_URL=http://127.0.0.1:5000

# Set to 1 only when the site is served over https
JOBGUARD_HTTPS=0
